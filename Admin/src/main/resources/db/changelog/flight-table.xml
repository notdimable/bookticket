<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet id="create-flights-table" author="yourname">
        <createTable tableName="flights">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="flight_number" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="departure_airport" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="arrival_airport" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="departure_time" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="arrival_time" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="airline" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="economy_seats" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="business_seats" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="first_class_seats" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="available_seats" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="service_class" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>